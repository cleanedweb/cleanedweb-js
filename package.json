{
  "name": "cleanedweb",
  "version": "0.1.1",
  "description": "JavaScript and TypeScript SDK for CleanedWeb: run maintained REST APIs that return structured records from public website collections.",
  "keywords": ["cleanedweb", "web data", "scraping", "api", "structured data", "sdk", "records"],
  "homepage": "https://cleanedweb.com/?utm_source=github&utm_medium=cleanedweb-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cleanedweb/cleanedweb-js.git"
  },
  "bugs": {
    "url": "https://github.com/cleanedweb/cleanedweb-js/issues"
  },
  "license": "MIT",
  "author": "CleanedWeb",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "CHANGELOG.md"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:live": "CLEANEDWEB_LIVE=1 vitest run test/live.test.ts",
    "test:dist": "node scripts/check-dist.mjs",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^18.19.0",
    "eslint": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "vite": "^6.0.0"
  }
}
